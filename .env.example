# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nearcart?appName=Cluster0
JWT_SECRET=replace_with_long_random_secret_string
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# Your deployed frontend URL (e.g. https://nearcart.netlify.app)
FRONTEND_URL=https://your-frontend-url.netlify.app
